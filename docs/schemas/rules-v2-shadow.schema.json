{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://just.invalid/schema/rules-v2-shadow.schema.json",
  "title": "Just rule v1/v2 migration shadow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules_schema_version", "rules", "difference_counts"],
  "properties": {
    "schema_version": { "const": "JUST-RULES-D002-V2-SHADOW-1" },
    "rules_schema_version": { "const": "JUST-RULES-D002-V2" },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    },
    "difference_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "legacy_kind", "legacy_role", "legacy_terminal", "legacy_count", "typed", "differences"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "legacy_kind": { "enum": ["sink", "magic-entry", "source", "model", "chain-fragment", "unknown"] },
        "legacy_role": { "enum": ["CAPABILITY", "TERMINAL", "NONE"] },
        "legacy_terminal": { "type": "boolean" },
        "legacy_count": { "type": "integer", "minimum": 1 },
        "typed": { "$ref": "rules-v2.schema.json#/$defs/rule" },
        "differences": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" },
          "uniqueItems": true
        }
      }
    }
  }
}
