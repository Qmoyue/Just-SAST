{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://just.invalid/schema/concise-report-v1.schema.json",
  "title": "Just concise static report",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "static_safety",
    "artifact_sha256",
    "run",
    "summary",
    "chains"
  ],
  "properties": {
    "schema_version": { "const": "JUST-REPORT-V1" },
    "mode": { "enum": ["component", "application"] },
    "static_safety": {
      "type": "object",
      "required": ["verification_mode", "target_code_execution_possible", "target_code_executed", "dynamic_filtering"],
      "properties": {
        "verification_mode": { "const": "STATIC_ONLY" },
        "target_code_execution_possible": { "const": false },
        "target_code_executed": { "const": "NO" },
        "dynamic_filtering": { "const": "ANALYSIS_ONLY" }
      },
      "additionalProperties": false
    },
    "artifact_sha256": { "type": "string", "minLength": 1 },
    "run": { "type": "object", "required": ["status", "completeness", "chain_proof_completeness", "reason_codes"] },
    "summary": { "type": "object", "required": ["candidates", "exported"] },
    "chains": { "type": "array", "items": { "type": "object", "required": ["id", "exported", "entry", "sink", "state", "hops"] } }
  },
  "additionalProperties": false
}
