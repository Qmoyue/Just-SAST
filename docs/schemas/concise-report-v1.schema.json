{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://just.invalid/schema/concise-report-v1.schema.json",
  "title": "Just concise static report",
  "type": "object",
  "required": ["schema_version", "mode", "analysis", "artifact_sha256", "run", "summary", "presentation", "filter_evidence", "result_explanation", "chains"],
  "properties": {
    "schema_version": { "const": "JUST-REPORT-V1" },
    "mode": { "enum": ["component", "application"] },
    "analysis": {
      "type": "object",
      "required": ["mode", "filter_evidence"],
      "properties": {
        "mode": { "const": "STATIC_ONLY" },
        "filter_evidence": { "const": "meta/scan-metadata.json" }
      },
      "additionalProperties": false
    },
    "artifact_sha256": { "type": "string", "minLength": 1 },
    "run": {
      "type": "object",
      "required": ["outcome", "coverage", "chain_proof_coverage", "coverage_reasons", "exit_code"],
      "properties": {
        "outcome": { "enum": ["FINDINGS_AVAILABLE", "NO_FINDINGS", "FAILED", "USAGE_ERROR", "UNSUPPORTED", "NOT_RUN"] },
        "coverage": { "enum": ["COMPLETE", "BOUNDED", "UNKNOWN"] },
        "chain_proof_coverage": { "enum": ["COMPLETE", "BOUNDED", "UNKNOWN"] },
        "coverage_reasons": { "type": "array", "items": { "type": "string" } },
        "exit_code": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "required": ["display_limit", "detailed_count", "compact_count", "json_candidate_count", "json_truncated", "search_budget"],
      "properties": {
        "display_limit": { "type": "integer", "minimum": 0 },
        "detailed_count": { "type": "integer", "minimum": 0 },
        "compact_count": { "type": "integer", "minimum": 0 },
        "json_candidate_count": { "type": "integer", "minimum": 0 },
        "json_truncated": { "const": false },
        "search_budget": { "$ref": "#/$defs/search_budget" }
      },
      "additionalProperties": false
    },
    "filter_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/filter_evidence" }
    },
    "summary": {
      "type": "object",
      "required": ["candidates", "exported", "files_scanned", "classes_loaded", "elapsed_ms"],
      "properties": {
        "candidates": { "type": "integer", "minimum": 0 },
        "exported": { "type": "integer", "minimum": 0 },
        "files_scanned": { "type": "integer", "minimum": 0 },
        "classes_loaded": { "type": "integer", "minimum": 0 },
        "elapsed_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "result_explanation": {
      "type": "object",
      "required": ["kind", "message", "candidate_count", "exported_count", "reason_codes"],
      "properties": {
        "kind": { "enum": ["EMPTY", "AUDIT_CANDIDATES_ONLY", "EXPORTED_CANDIDATES"] },
        "message": { "type": "string", "minLength": 1 },
        "candidate_count": { "type": "integer", "minimum": 0 },
        "exported_count": { "type": "integer", "minimum": 0 },
        "reason_codes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "chains": { "type": "array", "items": { "$ref": "#/$defs/chain" } }
  },
  "$defs": {
    "chain": {
      "type": "object",
      "required": ["id", "chain_key", "exported", "rule_id", "category", "severity", "entry", "sink", "state", "constraints", "ranking", "confidence", "precision", "construction", "notes", "graph", "object_relations", "hops", "application_trace"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "chain_key": { "type": "string", "minLength": 1 },
        "exported": { "type": "boolean" },
        "rule_id": { "type": "string" },
        "category": { "type": "string" },
        "severity": { "type": "string" },
        "entry": {
          "type": "object",
          "required": ["class", "method", "descriptor", "kind"],
          "properties": { "class": { "type": "string" }, "method": { "type": "string" }, "descriptor": { "type": "string" }, "kind": { "type": "string" } },
          "additionalProperties": false
        },
        "sink": {
          "type": "object",
          "required": ["class", "method", "descriptor", "role", "risk"],
          "properties": { "class": { "type": "string" }, "method": { "type": "string" }, "descriptor": { "type": "string" }, "role": { "type": "string" }, "risk": { "type": "string" } },
          "additionalProperties": false
        },
        "state": {
          "type": "object",
          "required": ["entry_status", "chain_progress", "feasibility", "completeness", "risk", "eligibility", "violations"],
          "properties": {
            "entry_status": { "type": "string" }, "chain_progress": { "type": "string" }, "feasibility": { "type": "string" },
            "completeness": { "type": "string" }, "risk": { "type": "string" },
            "eligibility": { "type": "string" }, "violations": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "confidence": {
          "type": "object",
          "required": ["bucket", "reason", "static_rank", "total_score"],
          "properties": {
            "bucket": { "type": "string" }, "reason": { "type": "string" },
            "static_rank": { "type": "integer", "minimum": 0 },
            "total_score": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "precision": {
          "type": "object",
          "required": ["controllability", "dispatch_precision", "field_precision", "reflection_precision", "construction", "completeness", "rank", "high_confidence", "reasons"],
          "properties": {
            "controllability": { "type": "string" }, "dispatch_precision": { "type": "string" },
            "field_precision": { "type": "string" }, "reflection_precision": { "type": "string" },
            "construction": { "type": "string" }, "completeness": { "type": "string" },
            "rank": { "type": "integer", "minimum": 0 }, "high_confidence": { "type": "boolean" },
            "reasons": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "constraints": {
          "type": "object",
          "required": ["feasibility", "completeness", "violations", "unresolved_hops"],
          "properties": {
            "feasibility": { "type": "string" }, "completeness": { "type": "string" },
            "violations": { "type": "array", "items": { "type": "string" } }, "unresolved_hops": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "ranking": {
          "type": "object",
          "required": ["static_score", "precision_rank", "explanation"],
          "properties": { "static_score": { "type": "number" }, "precision_rank": { "type": "integer" }, "explanation": { "type": "string" } },
          "additionalProperties": false
        },
        "construction": {
          "type": "object",
          "required": ["overall", "type", "fields", "trigger", "sink_control", "reasons"],
          "properties": {
            "overall": { "type": "string" }, "type": { "type": "string" }, "fields": { "type": "string" },
            "trigger": { "type": "string" }, "sink_control": { "type": "string" }, "reasons": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "notes": { "type": "array", "items": { "type": "string" } },
        "graph": { "$ref": "#/$defs/graph" },
        "object_relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "kind", "field", "field_owner"],
            "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "kind": { "type": "string" }, "field": { "type": "string" }, "field_owner": { "type": ["string", "null"] } },
            "additionalProperties": false
          }
        },
        "hops": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["hop_index", "from", "from_descriptor", "to", "kind", "field", "reason", "descriptor", "arg_ordinal", "field_owner"],
            "properties": {
              "hop_index": { "type": "integer", "minimum": 1 }, "from": { "type": "string" }, "from_descriptor": { "type": ["string", "null"] }, "to": { "type": "string" }, "kind": { "type": "string" }, "field": { "type": "string" },
              "reason": { "type": "string" }, "descriptor": { "type": "string" }, "arg_ordinal": { "type": ["integer", "null"] }, "field_owner": { "type": ["string", "null"] }, "location": { "$ref": "#/$defs/hop_location" }
            },
            "additionalProperties": false
          }
        },
        "application_trace": {
          "type": ["object", "null"],
          "required": ["application_entry_class", "application_entry_method", "application_site_class", "application_site_method", "application_site_kind", "join_kind", "chain_entry_method", "entry_prefix_path", "dependency_owner", "terminal_owner", "terminal_method", "join_evidence"],
          "properties": {
            "application_entry_class": { "type": "string" }, "application_entry_method": { "type": "string" },
            "application_site_class": { "type": "string" }, "application_site_method": { "type": "string" },
            "application_site_kind": { "type": "string" }, "join_kind": { "type": "string" }, "chain_entry_method": { "type": "string" },
            "entry_prefix_path": { "type": "string" }, "dependency_owner": { "type": "string" }, "terminal_owner": { "type": "string" }, "terminal_method": { "type": "string" },
            "join_evidence": {
              "type": ["object", "null"],
              "required": ["evidence_graph_digest", "artifact_digest", "application_index_digest", "join_id", "application_chain_id", "entry_atom_id", "site_atom_id", "dependency_segment_id", "value_flow", "object_identity", "callback_semantics", "runtime_type_proof", "artifact_compatibility", "filter_dominance", "construction_constraint", "bridge_evidence_ids"],
              "properties": {
                "evidence_graph_digest": { "type": "string" }, "artifact_digest": { "type": "string" }, "application_index_digest": { "type": "string" },
                "join_id": { "type": "string" }, "application_chain_id": { "type": "string" },
                "entry_atom_id": { "type": "string" }, "site_atom_id": { "type": "string" }, "dependency_segment_id": { "type": "string" },
                "value_flow": { "type": "string" }, "object_identity": { "type": "string" }, "callback_semantics": { "type": "string" },
                "runtime_type_proof": { "type": "string" }, "artifact_compatibility": { "type": "string" }, "filter_dominance": { "type": "string" },
                "construction_constraint": { "type": "string" }, "bridge_evidence_ids": { "type": "array", "items": { "type": "string" } },
                "static_proof": { "$ref": "#/$defs/static_proof" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
    ,"static_proof": {
      "type": ["object", "null"],
      "properties": {
        "input_flow_status": { "type": "string" },
        "input_flow_stages": { "type": "string" },
        "input_parameter_slots": { "type": "array", "items": { "type": "string" } },
        "deserialized_element_types": { "type": "array", "items": { "type": "string" } },
        "reflection_resolution": { "type": "string" },
        "reflection_host": { "type": "string" },
        "reflection_receiver_precision": { "type": "string" },
        "reflection_method_name": { "type": "string" },
        "reflection_descriptor": { "type": "string" },
        "reflection_inputs": { "type": "array", "items": { "type": "string" } },
        "reflection_reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
    ,"graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "role"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "role": { "enum": ["ENTRY", "STEP", "TERMINAL", "BOUNDARY"] }
            },
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "kind", "reason"],
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
    ,"hop_location": {
      "type": ["object", "null"],
      "required": ["status", "basis", "method_descriptor", "bytecode_offset", "candidate_count", "artifact"],
      "properties": {
        "status": { "enum": ["PROVEN", "UNKNOWN"] },
        "basis": { "type": "string" },
        "method_descriptor": { "type": "string" },
        "bytecode_offset": { "type": ["integer", "null"], "minimum": 0 },
        "candidate_count": { "type": "integer", "minimum": 0 },
        "artifact": { "$ref": "#/$defs/artifact" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": ["object", "null"],
      "required": ["logical_name", "role", "sha256", "size_bytes"],
      "properties": {
        "logical_name": { "type": "string" },
        "role": { "type": "string" },
        "sha256": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": -1 }
      },
      "additionalProperties": false
    }
    ,"filter_evidence": {
      "type": "object",
      "required": ["kind", "location", "status", "reason_code", "domain_digest", "semantic_digest", "budget", "evaluated", "retained", "rejected", "expanded", "filter_cost_nanos"],
      "properties": {
        "kind": { "type": "string" }, "location": { "type": "string" },
        "status": { "enum": ["PROVABLY_UNREACHABLE", "PROVEN_RETAINED", "UNKNOWN", "BUDGET_EXCEEDED"] },
        "reason_code": { "type": "string" }, "domain_digest": { "type": "string" },
        "semantic_digest": { "type": "string" }, "budget": { "type": "integer", "minimum": 0 },
        "evaluated": { "type": "integer", "minimum": 0 }, "retained": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 }, "expanded": { "type": "integer", "minimum": 0 },
        "filter_cost_nanos": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "search_budget": {
      "type": "object",
      "required": ["source", "status", "step_limit", "method_pass_limit", "round_limit"],
      "properties": {
        "source": { "const": "meta/scan-metadata.json" },
        "status": { "enum": ["BOUNDED", "UNKNOWN"] },
        "step_limit": { "type": ["integer", "null"], "minimum": 0 },
        "method_pass_limit": { "type": ["integer", "null"], "minimum": 0 },
        "round_limit": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
