{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://just-sast.dev/schema/finding-output-v1.json",
  "title": "Just SAST typed finding output reader snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "structured_verification", "findings"],
  "properties": {
    "schema_version": {"const": "JUST-FINDING-OUTPUT-D004-V1"},
    "structured_verification": {"type": "boolean"},
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "chain_key", "rule_id", "entry_class", "entry_method", "entry_kind",
        "sink_class", "sink_method", "sink_role", "sink_risk", "entry_status",
        "chain_progress", "feasibility", "completeness", "verification", "risk",
        "eligibility", "violations", "confidence", "confidence_reason", "static_rank",
        "total_score", "verification_status", "verification_group", "exported", "calibration"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^finding-[0-9a-f]{16,64}$"},
        "chain_key": {"type": "string"},
        "rule_id": {"type": "string"},
        "entry_class": {"type": "string"},
        "entry_method": {"type": "string"},
        "entry_kind": {"type": "string"},
        "sink_class": {"type": "string"},
        "sink_method": {"type": "string"},
        "sink_role": {"type": "string"},
        "sink_risk": {"type": "string", "enum": ["SAFE_CALLABLE", "CONTROLLED_EFFECT", "HIGH_RISK_TERMINAL"]},
        "entry_status": {"type": "string", "enum": ["NO_APPLICATION_ENTRY", "APPLICATION_ENTRY", "EXTERNAL_ENTRY"]},
        "chain_progress": {"type": "string", "enum": ["ENTRY_IDENTIFIED", "BOUNDARY_REACHED", "DEPENDENCY_JOINED", "IMPACT_CHAIN_COMPLETE"]},
        "feasibility": {"type": "string", "enum": ["SAT", "UNSAT", "UNKNOWN"]},
        "completeness": {"type": "string", "enum": ["COMPLETE", "PARTIAL", "UNKNOWN"]},
        "verification": {"type": "string", "enum": ["NOT_REQUESTED", "NOT_ATTEMPTED", "DYNAMIC_SEGMENT_CONFIRMED", "DYNAMIC_BOUNDARY_CONFIRMED", "SAFE_TERMINAL_CONFIRMED", "CONTRADICTION_OBSERVED", "UNKNOWN", "FAILED", "UNSUPPORTED"]},
        "risk": {"type": "string", "enum": ["NONE", "LOW", "MEDIUM", "HIGH", "CRITICAL", "UNKNOWN"]},
        "eligibility": {"type": "string", "enum": ["ELIGIBLE_APPLICATION_CHAIN", "NO_APPLICATION_ENTRY", "APPLICATION_ENTRY_NOT_EXTERNAL", "CHAIN_NOT_IMPACT_COMPLETE", "CONSTRAINTS_UNSAT", "CONSTRAINTS_UNKNOWN", "ANALYSIS_INCOMPLETE", "RISK_UNKNOWN", "RISK_NOT_ACTIONABLE"]},
        "violations": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "string"},
        "confidence_reason": {"type": "string"},
        "static_rank": {"type": "integer", "minimum": 0},
        "total_score": {"type": "integer", "minimum": 0},
        "verification_status": {"type": "string"},
        "verification_group": {"type": "string"},
        "exported": {"type": "boolean"},
        "calibration": {"type": "string"}
      }
    }
  }
}
