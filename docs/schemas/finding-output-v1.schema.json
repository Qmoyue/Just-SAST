{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://just-sast.dev/schema/finding-output-v1.json",
  "title": "Just legacy typed finding output reader snapshot",
  "description": "Legacy/internal reader snapshot retained only while consumers migrate to the V3 concise projection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "findings"],
  "properties": {
    "schema_version": {"const": "JUST-FINDING-OUTPUT-D004-V1"},
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "chain_key", "rule_id", "entry_class", "entry_method", "entry_descriptor",
        "entry_kind", "sink_class", "sink_method", "sink_role", "sink_risk", "entry_status",
        "chain_progress", "feasibility", "completeness", "risk", "eligibility", "violations",
        "confidence", "confidence_reason", "static_rank", "total_score", "exported", "calibration",
        "application_trace"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^finding-[0-9a-f]{16,64}$"},
        "chain_key": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string"},
        "entry_class": {"type": "string"},
        "entry_method": {"type": "string"},
        "entry_descriptor": {"type": "string"},
        "entry_kind": {"type": "string"},
        "sink_class": {"type": "string"},
        "sink_method": {"type": "string"},
        "sink_role": {"type": "string"},
        "sink_risk": {"enum": ["SAFE_CALLABLE", "CONTROLLED_EFFECT", "HIGH_RISK_TERMINAL"]},
        "entry_status": {"enum": ["NO_APPLICATION_ENTRY", "APPLICATION_ENTRY", "EXTERNAL_ENTRY"]},
        "chain_progress": {"enum": ["ENTRY_IDENTIFIED", "BOUNDARY_REACHED", "DEPENDENCY_JOINED", "IMPACT_CHAIN_COMPLETE"]},
        "feasibility": {"enum": ["SAT", "UNSAT", "UNKNOWN"]},
        "completeness": {"enum": ["COMPLETE", "PARTIAL", "UNKNOWN"]},
        "risk": {"enum": ["NONE", "LOW", "MEDIUM", "HIGH", "CRITICAL", "UNKNOWN"]},
        "eligibility": {"enum": ["ELIGIBLE_APPLICATION_CHAIN", "NO_APPLICATION_ENTRY", "APPLICATION_ENTRY_NOT_EXTERNAL", "CHAIN_NOT_IMPACT_COMPLETE", "CONSTRAINTS_UNSAT", "CONSTRAINTS_UNKNOWN", "ANALYSIS_INCOMPLETE", "RISK_UNKNOWN", "RISK_NOT_ACTIONABLE"]},
        "violations": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "string"},
        "confidence_reason": {"type": "string"},
        "static_rank": {"type": "integer", "minimum": 0},
        "total_score": {"type": "integer", "minimum": 0},
        "exported": {"type": "boolean"},
        "calibration": {"type": "string"},
        "application_trace": {
          "type": ["object", "null"],
          "properties": {
            "application_entry_class": {"type": "string"},
            "application_entry_method": {"type": "string"},
            "application_site_class": {"type": "string"},
            "application_site_method": {"type": "string"},
            "application_site_kind": {"type": "string"},
            "join_kind": {"type": "string"},
            "chain_entry_method": {"type": "string"},
            "entry_prefix_path": {"type": "string"},
            "dependency_owner": {"type": "string"},
            "terminal_owner": {"type": "string"},
            "terminal_method": {"type": "string"},
            "join_evidence": {
              "type": ["object", "null"],
              "required": ["evidence_graph_digest", "artifact_digest", "application_index_digest", "join_id", "application_chain_id", "entry_atom_id", "site_atom_id", "dependency_segment_id", "value_flow", "object_identity", "callback_semantics", "runtime_type_proof", "artifact_compatibility", "filter_dominance", "construction_constraint", "bridge_evidence_ids"],
              "properties": {
                "evidence_graph_digest": {"type": "string"}, "artifact_digest": {"type": "string"}, "application_index_digest": {"type": "string"},
                "join_id": {"type": "string"}, "application_chain_id": {"type": "string"},
                "entry_atom_id": {"type": "string"}, "site_atom_id": {"type": "string"}, "dependency_segment_id": {"type": "string"},
                "value_flow": {"type": "string"}, "object_identity": {"type": "string"}, "callback_semantics": {"type": "string"},
                "runtime_type_proof": {"type": "string"}, "artifact_compatibility": {"type": "string"}, "filter_dominance": {"type": "string"},
                "construction_constraint": {"type": "string"}, "bridge_evidence_ids": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          },
          "required": [
            "application_entry_class", "application_entry_method", "application_site_class",
            "application_site_method", "application_site_kind", "join_kind", "chain_entry_method",
            "entry_prefix_path", "dependency_owner", "terminal_owner", "terminal_method", "join_evidence"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
