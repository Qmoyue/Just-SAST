# Generated builds and downloaded Java targets, including arbitrary filenames.
# Build public fixtures from source; allow the Maven wrapper bootstrap JAR.
target/
/out/
/build/
/dist/
/release/
/release-dist/
/artifacts/
*.class
*.jar
*.war
*.ear
*.jmod
!/.mvn/wrapper/maven-wrapper.jar
*.o
*.obj
*.pdb
*.ilk
*.exp
dependency-reduced-pom.xml
pom.xml.versionsBackup
pom.xml.releaseBackup
release.properties

# Root-level distribution bundles and checksums are release assets, not source.
/*.zip
/*.7z
/*.rar
/*.tar
/*.tar.gz
/*.tar.xz
/*.tgz
/*.sha256
/*.sha512
/SHA256SUMS
/SHA512SUMS

# Local scan output. Keep JSON/Markdown/CSV fixtures elsewhere trackable.
# Use these root directories for custom outputs instead of arbitrary names.
just-out/
/just-out-*/
/reports/
/findings/
/evidence/
/verification/
/meta/
/report.md
/report.json
/report.sarif
/run.json
/chains.csv
/findings.csv
/performance.json
just-fragments.ser
/*.ser
/*-current.txt
/*.eval.txt

# ReportTransaction/ScanCache siblings and AtomicFiles temporary writes.
.*.staging-*/
*.backup-*/
.*.tmp-*

# Private corpus, experiments, agent state and local helper environments.
# Root anchoring keeps public src/test fixtures and .github/scripts trackable.
/benchmark/
/tools/
/.agents/
/.codex/
/AGENTS.md
/.inspect-*/
/work/
/tmp/
/temp/
/.tmp/
/.cache/
/cache/
/.just-cache/
/just-cache/
/just-cache-*/
/.m2/
/downloads/
/.venv/
/venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Runtime logs, crash diagnostics and profiler recordings.
*.log
*.log.*
*.hprof
*.jfr
*.dump
*.dumpstream
*.stackdump
*.pid
/javac.*.args

# Local credentials and signing material. Examples contain placeholders only.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.credentials
*credentials*.json
*secrets*.json
*.asc

# Editor/OS metadata and scratch copies.
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.tmp
*.bak
*.orig

# Public docs are explicit; handoff plans and experiment histories stay local.
# Add future public documentation here, never force-add private handoff files.
/docs/*
!/docs/
!/docs/architecture.md
!/docs/requirements.md
!/docs/schemas/
!/docs/schemas/*.json
