<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.just</groupId>
  <artifactId>just-sast</artifactId>
  <version>0.2.0</version>
  <packaging>jar</packaging>

  <name>Just SAST</name>
  <description>Lightweight bytecode-based static analyzer for Java deserialization gadget chain discovery</description>
  <licenses>
    <license>
      <name>GNU General Public License v3.0 only</name>
      <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
    </license>
  </licenses>

  <properties>
    <!--
      Keep source/target instead of the release flag. The Jabba JDKs used by the
      supported development environment return a spurious compiler-resource
      failure after successfully writing classes when the release flag is present.
      The project requires JDK 17 at runtime, and the verifier source below is
      checked separately for Java 8 bytecode/API compatibility.
    -->
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <asm.version>9.8</asm.version>
    <picocli.version>4.7.7</picocli.version>
    <snakeyaml.version>2.4</snakeyaml.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm</artifactId>
      <version>${asm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm-tree</artifactId>
      <version>${asm.version}</version>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
      <version>${picocli.version}</version>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>${snakeyaml.version}</version>
    </dependency>
    <!-- Windows Job Object support for the optional OS-isolated verifier parent. The
         Java-8 probe artifact does not include this dependency; the parent owns the
         operating-system attachment before releasing the child probe. -->
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna-platform</artifactId>
      <version>5.7.0</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <executions>
          <execution>
            <id>compile-java8-verifier</id>
            <phase>compile</phase>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <source>8</source>
              <target>8</target>
              <compileSourceRoots>
                <compileSourceRoot>${project.basedir}/src/verify8/java</compileSourceRoot>
              </compileSourceRoots>
              <outputDirectory>${project.build.directory}/verify8-classes</outputDirectory>
              <useIncrementalCompilation>false</useIncrementalCompilation>
              <!-- main uses the Java 17 release in a separate compiler invocation. Reusing
                   the same javac file manager across the release/output switch triggers
                   "cannot close compiler resources" on Windows JDK 17. Keep the
                   compatibility artifact isolated without changing production classes. -->
              <compilerReuseStrategy>reuseNone</compilerReuseStrategy>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>unpack-asm-for-java8-verifier</id>
            <phase>process-classes</phase>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <configuration>
              <includeArtifactIds>asm</includeArtifactIds>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/verify8-classes</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>unpack-asm-for-test-probe</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <configuration>
              <includeArtifactIds>asm</includeArtifactIds>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.outputDirectory}</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <executions>
          <!-- mvn test runs before package. Build the same agent-capable probe JAR at
               process-test-classes so dynamic contract tests do not silently become
               verifier-artifact-missing. The package execution below remains the release
               artifact used by the CLI. -->
          <execution>
            <id>test-probe</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>testprobe</classifier>
              <classesDirectory>${project.build.outputDirectory}</classesDirectory>
              <archive>
                <manifestEntries>
                  <Premain-Class>io.just.sast.verify.SinkCanaryAgent</Premain-Class>
                  <Can-Retransform-Classes>true</Can-Retransform-Classes>
                </manifestEntries>
              </archive>
            </configuration>
          </execution>
          <execution>
            <id>test-java8-verifier</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>verify8</classifier>
              <classesDirectory>${project.build.directory}/verify8-classes</classesDirectory>
              <archive>
                <manifestEntries>
                  <Premain-Class>io.just.sast.verify.legacy.LegacySinkCanaryAgent</Premain-Class>
                  <Can-Retransform-Classes>true</Can-Retransform-Classes>
                </manifestEntries>
              </archive>
            </configuration>
          </execution>
          <execution>
            <id>package-java8-verifier</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>verify8</classifier>
              <classesDirectory>${project.build.directory}/verify8-classes</classesDirectory>
              <archive>
                <manifestEntries>
                  <Premain-Class>io.just.sast.verify.legacy.LegacySinkCanaryAgent</Premain-Class>
                  <Can-Retransform-Classes>true</Can-Retransform-Classes>
                </manifestEntries>
              </archive>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.just.sast.cli.JustMain</mainClass>
                  <manifestEntries>
                    <Premain-Class>io.just.sast.verify.SinkCanaryAgent</Premain-Class>
                    <Can-Retransform-Classes>true</Can-Retransform-Classes>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
